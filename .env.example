# Copy to `.env` and fill in as needed. `.env` is gitignored — never commit keys.
#
# The app reads `.env` from the project root (this folder), or ~/.config/ace/.env.
# Speech-to-text uses Apple's on-device engine and needs NO keys.

# --- Brain: local Ollama (private, offline) ---
# Install Ollama (https://ollama.com), then pull the model below, e.g.:
#   ollama pull llama3.2
# Defaults shown; uncomment to override.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Voice: ElevenLabs (optional) ---
# Without a key, Ace speaks with the built-in macOS voice.
# Get a key at https://elevenlabs.io (Profile ▸ API Keys). Billed per character.
# ELEVENLABS_API_KEY=sk_your_key_here
# Voice ID (defaults to the one you picked):
# ELEVENLABS_VOICE_ID=tEo3d4j7gzVojBL5Z4Pt
