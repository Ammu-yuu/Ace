# Copy to `.env` and fill in as needed. `.env` is gitignored — never commit keys.
#
# The app reads `.env` from the project root (this folder), or ~/.config/ace/.env.
# Speech-to-text uses Apple's on-device engine and needs NO keys.

# --- Brain: Claude API (Anthropic) ---
# Get a key at https://console.anthropic.com (API Keys). Billed per use.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional model override (default is a fast, cheap Haiku model):
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Brain: local Ollama (used only if no ANTHROPIC_API_KEY above) ---
# Install Ollama (https://ollama.com), then: ollama pull llama3.2
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Voice output: ElevenLabs (optional; deferred for now) ---
# Without a key, Ace speaks with the built-in macOS voice.
# ELEVENLABS_API_KEY=sk_your_key_here
# ELEVENLABS_VOICE_ID=tEo3d4j7gzVojBL5Z4Pt
